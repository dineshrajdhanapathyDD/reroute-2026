# Re:Route AI — AWS services integration toggles.
# Copy to .env (or export in your shell) and provide AWS credentials to enable
# real AWS services. Without these, the app runs on deterministic/local fallbacks.

# --- AWS credentials (any standard method also works: aws configure, IAM role) ---
AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Amazon Bedrock: Strands agent model (Nova / Claude) ---
# Enable the real LLM-driven Strands agent (else deterministic tool pipeline).
REROUTE_USE_STRANDS_MODEL=1
# Amazon models only: nova-premier | nova-pro | nova-lite | nova-micro
REROUTE_MODEL=nova-pro
# Or a raw Amazon Bedrock model id (overrides REROUTE_MODEL):
# REROUTE_BEDROCK_MODEL=us.amazon.nova-pro-v1:0

# --- Amazon Bedrock Titan Text Embeddings: semantic session search + RAG ---
REROUTE_USE_BEDROCK_EMBEDDINGS=1
REROUTE_EMBED_MODEL=amazon.titan-embed-text-v2:0

# --- Amazon Polly: text-to-speech (else browser speech synthesis) ---
REROUTE_USE_POLLY=1
REROUTE_POLLY_VOICE=Matthew

# --- reinvent2026-mcp: serve sessions from the standalone MCP server ---
REROUTE_USE_MCP=1
REROUTE_MCP_CMD=reinvent2026-mcp
# Dev (package not pip-installed): use the module form + package path
# REROUTE_MCP_CMD=python
# REROUTE_MCP_ARGS=-m reinvent2026_mcp.server
# REROUTE_MCP_PYTHONPATH=d:/github work/reinvent2026-mcp

# --- RAG tips knowledge base (optional custom file) ---
# REROUTE_TIPS_FILE=d:/path/to/your_reinvent_tips.json
